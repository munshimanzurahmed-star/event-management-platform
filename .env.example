# ===========================================
# REQUIRED - Enter these in Vercel Dashboard
# Project → Settings → Environment Variables
# ===========================================

# Neon PostgreSQL (from Neon Console → Connect)
# Use the POOLED connection string for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection - needed for migrations / Prisma CLI
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth secret (generate a long random string)
# You can use: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-secret-here"

# Public URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Resend.com (https://resend.com → API Keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="BUSINESS ADD-ON"

# Vercel Blob (auto-injected when you enable Blob storage in Vercel,
# or create a token at https://vercel.com/dashboard/stores)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Optional but recommended for cron / protected endpoints
CRON_SECRET="another-random-secret-for-cron-jobs"

# ===========================================
# OPTIONAL
# ===========================================
# IMAGE_STORAGE is Vercel Blob by default when BLOB_READ_WRITE_TOKEN is set
